{
  "expo": {
    "name": "CampusDesk (dev)",
    "slug": "campusdesk-mobile",
    "scheme": "campusdesk",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-parent.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2a78d6",
        "foregroundImage": "./assets/icons/foreground.png",
        "monochromeImage": "./assets/icons/foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.campusdesk.dev",
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ]
  }
}
